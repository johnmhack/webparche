# ============================================
# TORKER BACKEND - VARIABLES DE ENTORNO
# ============================================
# Copiar este archivo a .env y configurar los valores apropiados
# NUNCA subir el archivo .env al repositorio

# ============================================
# ENTORNO
# ============================================
# Valores: development, staging, production
ENVIRONMENT=development

# ============================================
# DJANGO CORE
# ============================================
# CRÍTICO: Generar con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Debug mode - SIEMPRE False en producción
DEBUG=True

# Hosts permitidos (separados por coma)
# Ejemplo: localhost,127.0.0.1,midominio.com,www.midominio.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================
# BASE DE DATOS
# ============================================
# Desarrollo (SQLite)
# DATABASE_URL=sqlite:///db.sqlite3

# Producción (PostgreSQL)
# DATABASE_URL=postgresql://usuario:password@host:5432/nombre_db

# Railway/Heroku (se configura automáticamente)
DATABASE_URL=sqlite:///db.sqlite3

# ============================================
# CORS (Cross-Origin Resource Sharing)
# ============================================
# Orígenes permitidos (separados por coma)
# NUNCA usar * en producción
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================
# SEGURIDAD
# ============================================
# Forzar HTTPS en producción
SECURE_SSL_REDIRECT=False

# Cookies seguras (True en producción)
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# HSTS (HTTP Strict Transport Security)
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# ============================================
# JWT (JSON Web Tokens)
# ============================================
# Tiempo de vida del access token (en minutos)
JWT_ACCESS_TOKEN_LIFETIME=60

# Tiempo de vida del refresh token (en días)
JWT_REFRESH_TOKEN_LIFETIME=7

# ============================================
# EMAIL (Opcional)
# ============================================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ============================================
# ALMACENAMIENTO (Opcional)
# ============================================
# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# ============================================
# MONITOREO (Opcional)
# ============================================
# Sentry DSN para error tracking
SENTRY_DSN=

# ============================================
# REDIS (Opcional - para caché y Celery)
# ============================================
REDIS_URL=redis://localhost:6379/0

# ============================================
# SUPABASE (Ecosistema Parche + Torker)
# ============================================
# Mismo proyecto Supabase que la app Parche móvil
# Dashboard → Project Settings → API
SUPABASE_URL=
# SOLO backend — NUNCA en frontend. Bypass RLS con cuidado.
SUPABASE_SERVICE_ROLE_KEY=
# Anon/publishable key (validar tokens de login Parche)
SUPABASE_ANON_KEY=

# ============================================
# DIAN (Facturación Electrónica) — POSTERGADO
# ============================================
# Ambiente DIAN: test o production
DIAN_ENVIRONMENT=test

# URLs de webservices DIAN
DIAN_TEST_WEBSERVICE_URL=https://vpfe-hab.dian.gov.co/WcfDianCustomerServices.svc
DIAN_PRODUCTION_WEBSERVICE_URL=https://vpfe.dian.gov.co/WcfDianCustomerServices.svc

# Credenciales DIAN (ambiente de pruebas)
DIAN_TEST_USERNAME=
DIAN_TEST_PASSWORD=

# Credenciales DIAN (ambiente de producción)
DIAN_PRODUCTION_USERNAME=
DIAN_PRODUCTION_PASSWORD=

# Software ID y PIN (proporcionados por DIAN)
DIAN_SOFTWARE_ID=
DIAN_SOFTWARE_PIN=
DIAN_SOFTWARE_SECURITY_CODE=

# Certificado Digital Camerfirma (Firma Electrónica)
# Ruta al archivo .p12 o .pfx del certificado
DIAN_CERTIFICATE_PATH=workshops/certificates/certificado.p12
# Contraseña del certificado digital
DIAN_CERTIFICATE_PASSWORD=

# ============================================
# LOGGING
# ============================================
# Nivel de logging: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================
# RAILWAY/HEROKU ESPECÍFICO
# ============================================
# Estas variables se configuran automáticamente en Railway/Heroku
# PORT=8000
# RAILWAY_STATIC_URL=
# RAILWAY_ENVIRONMENT=production